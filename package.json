{
  "name": "rn-interactive-walkthrough",
  "version": "0.3.0",
  "description": "Create interactive walkthroughs and onboarding tutorials in react-native.",
  "main": "lib/commonjs/index.js",
  "react-native": "src/index.tsx",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "files": [
    "src",
    "lib"
  ],
  "scripts": {
    "prepare": "husky && bob build",
    "lint": "eslint --ext .js,.ts,.tsx .",
    "lint:fix": "eslint --ext .js,.ts,.tsx . --fix",
    "typecheck": "tsc --noEmit",
    "release": "release-it"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "author": "Olivier Allard",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CatLover01/rn-interactive-walkthrough.git"
  },
  "homepage": "https://github.com/CatLover01/rn-interactive-walkthrough#readme",
  "bugs": {
    "url": "https://github.com/CatLover01/rn-interactive-walkthrough/issues"
  },
  "keywords": [
    "walkthrough",
    "copilot",
    "intro",
    "tour",
    "react",
    "rn",
    "react-native",
    "javascript",
    "tutorial"
  ],
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.0",
    "@release-it/conventional-changelog": "^12.0.0",
    "@types/lodash": "^4.17.25",
    "@types/react": "^19.2.3",
    "commitlint": "^21.2.1",
    "eslint": "^10.8.0",
    "eslint-config-satya164": "^5.2.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "react": "^19.2.3",
    "react-native": "^0.86.2",
    "react-native-builder-bob": "^0.43.0",
    "react-native-reanimated": "^4.5.3",
    "release-it": "^21.0.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "lodash": "^4.18.1"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native": ">=0.63.0",
    "react-native-reanimated": ">=3.0.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
